{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "ags/gtk4",
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "strict": true,
        "noImplicitAny": false,
        "baseUrl": ".",
        "paths": {
            "@osiris/*": ["./*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"]
}
