# Osiris OS - Git Ignore

# Reference configs (extracted from other distros)
reference/

# Build artifacts
build/
*.iso

# Output directory (ISOs are generated, not committed)
output*/

# Generated config directory (built from config-gnome)
config/

# Docker build cache
.docker/

# Python
__pycache__/
*.py[cod]
venv/

# Temporary files
*.tmp
*.log
*~

# OS-specific files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
PR.md