# Osiris OS - Git Ignore

# Reference configs (extracted from other distros)
reference/

# Build artifacts
build/
*.iso

# Output directory (ISOs are generated, not committed)
output*/

# Generated config directory (built from config-gnome)
config/

# Docker build cache
.docker/

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Temporary files
*.tmp
*.log
# archinstall's command log: the installer tests run it as a normal user, so it
# falls back from /var/log/archinstall to the current directory.
cmd_history.txt
*~

# OS-specific files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
PR.md

.creds