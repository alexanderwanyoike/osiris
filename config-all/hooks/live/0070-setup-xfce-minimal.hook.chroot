#!/bin/bash
# Setup XFCE with beautiful minimalism

set -e

echo "=== Setting up XFCE beautiful minimalism ==="

SKEL_AUTOSTART="/etc/skel/.config/autostart"
SKEL_XFCE="/etc/skel/.config/xfce4"

# Create autostart directory
mkdir -p "$SKEL_AUTOSTART"

# Create Picom autostart
cat > "$SKEL_AUTOSTART/picom.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Picom
Comment=X11 compositor with blur and transparency
Exec=picom --config ~/.config/picom/picom.conf
Terminal=false
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
EOF

echo "✓ Picom autostart created"

# Create Plank autostart
cat > "$SKEL_AUTOSTART/plank.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Plank
Comment=Minimal dock
Exec=plank
Terminal=false
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
EOF

echo "✓ Plank autostart created"

# Create Calamares installer icon autostart (with proper trust handling for XFCE 4.18)
cat > "$SKEL_AUTOSTART/calamares-installer-icon.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Create Installer Icon
Exec=sh -c 'DESK=$(xdg-user-dir DESKTOP); cp /usr/share/applications/calamares-install-debian.desktop "$DESK/"; chmod +x "$DESK/calamares-install-debian.desktop"; sleep 2; gio set --type=string "$DESK/calamares-install-debian.desktop" metadata::xfce-exe-checksum "$(sha256sum "$DESK/calamares-install-debian.desktop" | cut -f1 -d" ")" 2>/dev/null || true'
StartupNotify=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF

echo "✓ Calamares installer icon autostart created"

# Copy autostart files to live user (user is created in hook 0010)
USER_AUTOSTART="/home/user/.config/autostart"
if [ -d "/home/user" ]; then
    echo "  → /home/user exists, copying autostart files..."
    mkdir -p "$USER_AUTOSTART"
    if cp "$SKEL_AUTOSTART/picom.desktop" "$USER_AUTOSTART/" 2>&1; then
        echo "  → Copied picom.desktop"
    else
        echo "  ✗ Failed to copy picom.desktop"
    fi
    if cp "$SKEL_AUTOSTART/plank.desktop" "$USER_AUTOSTART/" 2>&1; then
        echo "  → Copied plank.desktop"
    else
        echo "  ✗ Failed to copy plank.desktop"
    fi
    if cp "$SKEL_AUTOSTART/calamares-installer-icon.desktop" "$USER_AUTOSTART/" 2>&1; then
        echo "  → Copied calamares-installer-icon.desktop"
    else
        echo "  ✗ Failed to copy calamares-installer-icon.desktop"
    fi
    chown -R user:user /home/user/.config/autostart
    echo "✓ Autostart files copied to live user"
    echo "  Files in $USER_AUTOSTART:"
    ls -la "$USER_AUTOSTART/" || echo "  ✗ Directory doesn't exist!"
else
    echo "  ✗ WARNING: /home/user does not exist! Autostart files NOT copied!"
    echo "  This means Plank and Picom won't auto-start!"
fi

# Set dark mode as default for XFCE Terminal
if [ -f "$SKEL_XFCE/terminal/terminalrc-dark" ]; then
    cp "$SKEL_XFCE/terminal/terminalrc-dark" "$SKEL_XFCE/terminal/terminalrc"
    echo "✓ XFCE Terminal: dark mode set as default"
fi

# Ensure GTK dark CSS is active
SKEL_GTK="/etc/skel/.config/gtk-3.0"
if [ -f "$SKEL_GTK/gtk.css" ]; then
    cp "$SKEL_GTK/gtk.css" "$SKEL_GTK/gtk.css.active" 2>/dev/null || true
    echo "✓ GTK: grayscale CSS active"
fi

echo ""
echo "=== XFCE setup complete ==="
echo "✓ Picom will start automatically"
echo "✓ Plank dock will start automatically"
echo "✓ Dark mode is default"
echo "✓ Pure grayscale theme applied"
