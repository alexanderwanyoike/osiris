#!/bin/bash
set -e

echo "=== Fixing file permissions ==="

# Ensure configuration files are world-readable (0644)

# LightDM configuration files
if [ -f "/etc/lightdm/slick-greeter.conf" ]; then
    chmod 644 /etc/lightdm/slick-greeter.conf
    echo "✓ Fixed /etc/lightdm/slick-greeter.conf"
fi

if [ -f "/etc/lightdm/lightdm.conf.d/50-slick-greeter.conf" ]; then
    chmod 644 /etc/lightdm/lightdm.conf.d/50-slick-greeter.conf
    echo "✓ Fixed /etc/lightdm/lightdm.conf.d/50-slick-greeter.conf"
fi

# Session files
if [ -f "/usr/share/xsessions/xfce.desktop" ]; then
    chmod 644 /usr/share/xsessions/xfce.desktop
    echo "✓ Fixed /usr/share/xsessions/xfce.desktop"
fi

if [ -f "/usr/share/wayland-sessions/sway.desktop" ]; then
    chmod 644 /usr/share/wayland-sessions/sway.desktop
    echo "✓ Fixed /usr/share/wayland-sessions/sway.desktop"
fi

# Ensure directories are accessible
chmod 755 /usr/share/backgrounds/osiris 2>/dev/null || true
chmod 644 /usr/share/backgrounds/osiris/*.png 2>/dev/null || true

# Fix skel .config directory permissions (includes autostart files)
find /etc/skel/.config -type d -exec chmod 755 {} \; 2>/dev/null || true
find /etc/skel/.config -type f -exec chmod 644 {} \; 2>/dev/null || true

# Explicitly log autostart permission fixes
if [ -d "/etc/skel/.config/autostart" ]; then
    echo "✓ Fixed autostart files permissions"
fi

echo "✓ File permissions fixed"
