#!/bin/bash
# Create live user (autologin handled by live-config)

set -e

echo "=== Setting up live user ==="

# Ensure zsh is installed before creating user with zsh shell
apt-get install -y zsh

# Create user named 'user' (matches live-build default)
useradd -m -s /bin/zsh -G sudo,audio,video,plugdev,netdev,input user 2>/dev/null || true

# No password
passwd -d user

# Passwordless sudo
echo "user ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/user
chmod 0440 /etc/sudoers.d/user

echo "✓ User 'user' created with passwordless sudo"
echo "✓ Autologin will be configured by live-config in live mode"
echo "✓ Installed systems will show LightDM login screen"
