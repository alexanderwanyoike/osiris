#!/bin/bash
set -e

echo "=== Fixing Calamares desktop icon script to use symlinks ==="

SCRIPT="/usr/bin/add-calamares-desktop-icon"

if [ -f "$SCRIPT" ]; then
    # Replace the cp command with ln -s to create a symlink instead
    # Symlinks to files in /usr/share/applications/ are automatically trusted by XFCE
    sed -i 's|cp /usr/share/applications/calamares-install-debian.desktop \$DESKTOP|ln -sf /usr/share/applications/calamares-install-debian.desktop $DESKTOP/|' "$SCRIPT"

    # Remove the chmod +x line since symlinks don't need it
    sed -i '/chmod +x \$DESKTOP\/calamares-install-debian.desktop/d' "$SCRIPT"

    echo "✓ Updated Calamares desktop icon script to use symlinks"
else
    echo "⚠ Warning: $SCRIPT not found"
fi

echo "✓ Calamares desktop symlink fix complete"
