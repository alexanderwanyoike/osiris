#!/bin/bash
set -e

echo "=== Disabling Debian Calamares autostart (using our own) ==="

# Disable the Debian autostart since we have our own
DEBIAN_AUTOSTART="/etc/xdg/autostart/calamares-desktop-icon.desktop"

if [ -f "$DEBIAN_AUTOSTART" ]; then
    # Disable it by adding Hidden=true
    echo "Hidden=true" >> "$DEBIAN_AUTOSTART"
    echo "✓ Disabled Debian Calamares autostart"
else
    echo "⚠ Debian autostart not found"
fi

echo "✓ Autostart configuration complete"
