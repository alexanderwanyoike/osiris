#!/bin/bash
set -e

echo "=== Fixing Calamares installer icon ==="

# Fix the icon name in the Debian Calamares desktop file
CALAMARES_DESKTOP="/usr/share/applications/calamares-install-debian.desktop"

if [ -f "$CALAMARES_DESKTOP" ]; then
    # Replace install-debian icon with system-software-install (which exists in elementary-xfce theme)
    sed -i 's/^Icon=install-debian$/Icon=system-software-install/' "$CALAMARES_DESKTOP"
    echo "✓ Updated Calamares desktop file icon to system-software-install"
else
    echo "⚠ Warning: $CALAMARES_DESKTOP not found"
fi

echo "✓ Calamares icon fix complete"
