#!/bin/bash
set -e

echo "=== Updating icon caches and desktop database ==="

# Update GTK icon cache for Papirus themes
for theme in /usr/share/icons/Papirus* ; do
    if [ -d "$theme" ]; then
        echo "Updating cache for $(basename $theme)..."
        gtk-update-icon-cache -f -t "$theme" 2>/dev/null || true
    fi
done

# Update icon cache for hicolor (fallback theme)
if [ -d "/usr/share/icons/hicolor" ]; then
    echo "Updating hicolor icon cache..."
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi

# Update desktop database for .desktop files
if command -v update-desktop-database >/dev/null 2>&1; then
    echo "Updating desktop database..."
    update-desktop-database /usr/share/applications 2>/dev/null || true
fi

# Update MIME database
if command -v update-mime-database >/dev/null 2>&1; then
    echo "Updating MIME database..."
    update-mime-database /usr/share/mime 2>/dev/null || true
fi

echo "✓ Icon caches and databases updated"
