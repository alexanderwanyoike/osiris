#!/bin/bash
# Set dark mode as default and install theme switcher

set -e

echo "=== Setting up Osiris theme system ==="

# Create theme switcher script
cat > /usr/local/bin/osiris-theme <<'SCRIPTEOF'
#!/bin/bash
# Osiris Theme Switcher for Sway and XFCE

THEME_FILE="$HOME/.config/osiris-theme"

# Get current theme
get_current_theme() {
    if [ -f "$THEME_FILE" ]; then
        cat "$THEME_FILE"
    else
        echo "dark"
    fi
}

# Detect desktop environment
detect_desktop() {
    if [ "$XDG_CURRENT_DESKTOP" = "XFCE" ]; then
        echo "xfce"
    elif pgrep -x "sway" > /dev/null; then
        echo "sway"
    else
        echo "unknown"
    fi
}

# Set theme for Sway
set_theme_sway() {
    local theme=$1

    # Sway components
    [ -f "$HOME/.config/sway/config-$theme" ] && cp "$HOME/.config/sway/config-$theme" "$HOME/.config/sway/config"
    [ -f "$HOME/.config/waybar/style-$theme.css" ] && cp "$HOME/.config/waybar/style-$theme.css" "$HOME/.config/waybar/style.css"
    [ -f "$HOME/.config/wofi/style-$theme.css" ] && cp "$HOME/.config/wofi/style-$theme.css" "$HOME/.config/wofi/style.css"
    [ -f "$HOME/.config/foot/foot-$theme.ini" ] && cp "$HOME/.config/foot/foot-$theme.ini" "$HOME/.config/foot/foot.ini"

    # Update wofi config - use relative path (relative to $XDG_CONFIG_HOME/wofi)
    sed -i "s|stylesheet=.*|stylesheet=style.css|g" "$HOME/.config/wofi/config"

    # GTK icon theme (for GTK apps in Sway)
    mkdir -p "$HOME/.config/gtk-3.0"
    if [ "$theme" = "dark" ]; then
        gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' 2>/dev/null || true
        echo -e "[Settings]\ngtk-icon-theme-name=Papirus-Dark" > "$HOME/.config/gtk-3.0/settings.ini"
    else
        gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Light' 2>/dev/null || true
        echo -e "[Settings]\ngtk-icon-theme-name=Papirus-Light" > "$HOME/.config/gtk-3.0/settings.ini"
    fi

    # Reload Sway and Waybar
    swaymsg reload 2>/dev/null
    pkill waybar 2>/dev/null || true
    waybar & disown

    echo "  • Sway config updated"
    echo "  • Waybar reloaded"
    echo "  • Wofi theme updated"
    echo "  • Foot theme updated"
    echo "  • GTK icon theme updated"
}

# Set theme for XFCE
set_theme_xfce() {
    local theme=$1

    # GTK theme
    if [ "$theme" = "dark" ]; then
        xfconf-query -c xsettings -p /Net/ThemeName -s "Arc-Dark"
        xfconf-query -c xsettings -p /Net/IconThemeName -s "Papirus-Dark"
        cp "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css.active" 2>/dev/null || true
        xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/last-image -s "/usr/share/backgrounds/osiris/osiris-dark.png" 2>/dev/null || true
    else
        xfconf-query -c xsettings -p /Net/ThemeName -s "Arc"
        xfconf-query -c xsettings -p /Net/IconThemeName -s "Papirus-Light"
        cp "$HOME/.config/gtk-3.0/gtk-light.css" "$HOME/.config/gtk-3.0/gtk.css.active" 2>/dev/null || true
        xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/last-image -s "/usr/share/backgrounds/osiris/osiris-light.png" 2>/dev/null || true
    fi

    # Rofi theme
    sed -i "s|@theme \"osiris-.*\"|@theme \"osiris-$theme\"|g" "$HOME/.config/rofi/config.rasi" 2>/dev/null || true

    # XFCE Terminal (if config exists)
    if [ -f "$HOME/.config/xfce4/terminal/terminalrc-$theme" ]; then
        cp "$HOME/.config/xfce4/terminal/terminalrc-$theme" "$HOME/.config/xfce4/terminal/terminalrc"
    fi

    # Restart XFCE components
    xfce4-panel -r 2>/dev/null || true

    echo "  • GTK theme updated"
    echo "  • Rofi theme updated"
    echo "  • XFCE Terminal updated"
    echo "  • Desktop wallpaper updated"
}

# Set theme
set_theme() {
    local theme=$1
    local desktop=$(detect_desktop)

    echo "Switching to $theme mode..."

    # Save current theme
    echo "$theme" > "$THEME_FILE"

    # Apply theme based on desktop
    case "$desktop" in
        sway)
            set_theme_sway "$theme"
            ;;
        xfce)
            set_theme_xfce "$theme"
            ;;
        *)
            echo "Warning: Could not detect desktop environment"
            echo "Applying configs for both Sway and XFCE..."
            set_theme_sway "$theme"
            set_theme_xfce "$theme"
            ;;
    esac

    echo "✓ $theme mode activated"
}

case "$1" in
    dark)
        set_theme "dark"
        ;;
    light)
        set_theme "light"
        ;;
    toggle)
        current=$(get_current_theme)
        if [ "$current" = "dark" ]; then
            set_theme "light"
        else
            set_theme "dark"
        fi
        ;;
    *)
        current=$(get_current_theme)
        echo "Usage: osiris-theme [dark|light|toggle]"
        echo "Current theme: $current"
        exit 1
        ;;
esac
SCRIPTEOF

# Make it executable
chmod +x /usr/local/bin/osiris-theme

# Set dark mode as default in skel
SKEL_SWAY="/etc/skel/.config/sway"
SKEL_WAYBAR="/etc/skel/.config/waybar"
SKEL_WOFI="/etc/skel/.config/wofi"
SKEL_FOOT="/etc/skel/.config/foot"

# Copy dark configs as defaults
if [ -f "$SKEL_SWAY/config-dark" ]; then
    cp "$SKEL_SWAY/config-dark" "$SKEL_SWAY/config"
    echo "✓ Sway: dark mode set as default"
fi

if [ -f "$SKEL_WAYBAR/style-dark.css" ]; then
    cp "$SKEL_WAYBAR/style-dark.css" "$SKEL_WAYBAR/style.css"
    echo "✓ Waybar: dark mode set as default"
fi

if [ -f "$SKEL_WOFI/style-dark.css" ]; then
    cp "$SKEL_WOFI/style-dark.css" "$SKEL_WOFI/style.css"
    echo "✓ Wofi: dark mode set as default"
fi

if [ -f "$SKEL_FOOT/foot-dark.ini" ]; then
    cp "$SKEL_FOOT/foot-dark.ini" "$SKEL_FOOT/foot.ini"
    echo "✓ Foot: dark mode set as default"
fi

# Create default theme marker
echo "dark" > /etc/skel/.config/osiris-theme

echo ""
echo "=== Theme system setup complete ==="
echo "✓ Dark mode is default"
echo "✓ Theme switcher installed: osiris-theme [dark|light|toggle]"