#!/bin/bash
set -e

echo "=== Enabling Calamares netinstall module ==="

# Add netinstall to Calamares sequence if not already present
if [ -f /etc/calamares/settings.conf ]; then
    if ! grep -q "netinstall" /etc/calamares/settings.conf; then
        # Insert netinstall after keyboard in the show section
        sed -i '/^  - keyboard$/a\  - netinstall' /etc/calamares/settings.conf
        echo "✓ Added netinstall to installation sequence"
    else
        echo "✓ netinstall already enabled"
    fi
else
    echo "⚠ Warning: /etc/calamares/settings.conf not found"
fi
