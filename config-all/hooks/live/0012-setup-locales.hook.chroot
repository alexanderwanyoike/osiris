#!/bin/bash
# Setup locales and default shell

set -e

echo "=== Setting up locales ==="

# Generate common locales so they're available for users
# Calamares locale module will let users choose their preferred locale
cat >> /etc/locale.gen << 'EOF'
en_US.UTF-8 UTF-8
en_GB.UTF-8 UTF-8
de_DE.UTF-8 UTF-8
fr_FR.UTF-8 UTF-8
es_ES.UTF-8 UTF-8
it_IT.UTF-8 UTF-8
pt_BR.UTF-8 UTF-8
ru_RU.UTF-8 UTF-8
ja_JP.UTF-8 UTF-8
zh_CN.UTF-8 UTF-8
zh_TW.UTF-8 UTF-8
ko_KR.UTF-8 UTF-8
ar_SA.UTF-8 UTF-8
EOF

locale-gen

# Set a sensible default for live session (user can change during install)
update-locale LANG=en_US.UTF-8

echo "=== Setting zsh as default shell for new users ==="

# Set zsh as default shell for new users created by Calamares
if [ -f /etc/default/useradd ]; then
    sed -i 's|^SHELL=.*|SHELL=/bin/zsh|' /etc/default/useradd
else
    echo "SHELL=/bin/zsh" > /etc/default/useradd
fi

echo "Common locales generated (user selects during install)"
echo "Default shell set to /bin/zsh"
