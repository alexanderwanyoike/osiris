#!/bin/bash
# Build and install SwayFX for Osiris OS (official method)

set -e

echo "=== Installing SwayFX dependencies ==="

# Install library dependencies (build tools already installed via package list)
apt-get install -y \
    wayland-protocols \
    libwayland-dev \
    libpcre2-dev \
    libjson-c-dev \
    libpango-1.0-0 \
    libpango1.0-dev \
    libcairo2-dev \
    libgdk-pixbuf-2.0-dev \
    libevdev-dev \
    libinput-dev \
    libxkbcommon-dev \
    libdrm-dev \
    libgbm-dev \
    libpixman-1-dev \
    libsystemd-dev \
    libseat-dev \
    libegl-dev \
    libgles2-mesa-dev \
    xwayland \
    libxcb-composite0-dev \
    libxcb-icccm4-dev \
    libxcb-render0-dev \
    libxcb-xfixes0-dev \
    libxcb-res0-dev \
    scdoc

echo "=== Building wlroots (required for SwayFX) ==="

# Create build directory
mkdir -p /tmp/swayfx-build
cd /tmp/swayfx-build

# Download wlroots 0.16.2 (required version for SwayFX)
wget https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/0.16.2/wlroots-0.16.2.tar.gz
tar -xf wlroots-0.16.2.tar.gz
rm wlroots-0.16.2.tar.gz

# Build wlroots first (MUST be built before SwayFX)
cd wlroots-0.16.2
meson setup build/ -Dwerror=false -Dxwayland=enabled
ninja -C build/
ninja -C build/ install

echo "=== Building SwayFX ==="

# Download SwayFX 0.3.2
cd /tmp/swayfx-build
wget https://github.com/WillPower3309/swayfx/archive/refs/tags/0.3.2.tar.gz
tar -xf 0.3.2.tar.gz
rm 0.3.2.tar.gz

# Build SwayFX
cd swayfx-0.3.2
export CFLAGS="-Wno-error"
meson build/ -Dwerror=false --buildtype=plain
ninja -C build/ -v
ninja -C build/ install

# Update library cache
ldconfig

# Clean up build files
cd /
rm -rf /tmp/swayfx-build

echo "✓ SwayFX installed successfully"