#!/bin/bash
# Setup Oh-My-Zsh for the default user

set -e

echo "=== Setting up Oh-My-Zsh ==="

# Install dependencies
apt-get install -y curl git

# Install Oh-My-Zsh to /etc/skel so all new users get it
export HOME=/etc/skel
export ZSH=/etc/skel/.oh-my-zsh

# Download and install Oh-My-Zsh unattended
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Create .zshrc with robbyrussell theme
cat > /etc/skel/.zshrc << 'EOF'
# Path to Oh-My-Zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# Plugins
plugins=(git sudo history)

# Load Oh-My-Zsh
source $ZSH/oh-my-zsh.sh

# User configuration
export EDITOR='nvim'
export VISUAL='nvim'

# Aliases
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias cls='clear'

# History settings
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
EOF

# Copy to existing user home if user was already created
if [ -d /home/user ]; then
    cp -r /etc/skel/.oh-my-zsh /home/user/
    cp /etc/skel/.zshrc /home/user/
    chown -R user:user /home/user/.oh-my-zsh /home/user/.zshrc
    echo "Oh-My-Zsh copied to /home/user"
fi

echo "Oh-My-Zsh installed to /etc/skel"
echo "robbyrussell theme configured"
echo "Plugins: git, sudo, history"
