# Osiris SwayFX - Dark Mode
# Pure Black & White Minimal Theme

### Variables
set $mod Mod4
set $term foot
set $menu wofi --show drun

### SwayFX Effects
blur enable
blur_passes 3
blur_radius 5

corner_radius 12
smart_corner_radius on

shadows enable
shadows_on_csd disable
shadow_blur_radius 25
shadow_color #00000099

default_dim_inactive 0.1

### Layer Effects
layer_effects "waybar" {
    blur enable
    blur_ignore_transparent enable  
    shadows enable
    corner_radius 0
}

layer_effects "wofi" {
    blur enable
    blur_ignore_transparent enable
    shadows enable
    corner_radius 12
}

### Wallpaper - Dark
output * bg /usr/share/backgrounds/osiris/osiris-dark.png fill

### Autostart
exec waybar
exec mako
exec nm-applet

### Input
input type:keyboard {
    xkb_layout us
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
}

### Gaps & Borders
gaps inner 8
gaps outer 12
default_border pixel 2
default_floating_border pixel 2

### Colors - Pure Black & White
client.focused          #FFFFFF #000000 #FFFFFF #FFFFFF #FFFFFF
client.focused_inactive #444444 #000000 #888888 #444444 #444444
client.unfocused        #222222 #000000 #888888 #222222 #222222
client.urgent           #FFFFFF #FF0000 #FFFFFF #FFFFFF #FFFFFF

### Window Rules
for_window [app_id="foot"] opacity 0.90, blur enable
for_window [app_id="thunar"] opacity 0.92, blur enable
for_window [class="firefox"] opacity 0.95
for_window [app_id="pavucontrol"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable

### Keybindings
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec firefox
bindsym $mod+e exec thunar
bindsym $mod+q kill
bindsym $mod+f fullscreen
bindsym $mod+v split toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit

# Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# Layouts
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resize
mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# Screenshot
bindsym Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# Volume
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### Window Rules
for_window [app_id="foot"] opacity 0.70, blur disable     # ← No blur, more transparent
for_window [app_id="thunar"] opacity 0.85, blur enable
for_window [class="firefox"] opacity 0.95
for_window [app_id="pavucontrol"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable

exec autotiling -w 1 2 3 4 5     # ← Run autotiling on workspaces 1-5
