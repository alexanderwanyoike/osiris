#!/bin/sh
# Osiris Plymouth Watermark Hook
# This hook runs AFTER the plymouth hook (due to zz- prefix) and copies
# the Osiris watermark to the initramfs, overriding the Debian default.
#
# The standard plymouth initramfs hook copies /usr/share/desktop-base/debian-logos/logo-text-version-64.png
# as watermark.png for two-step themes. This hook restores our custom watermark.

set -e

PREREQ="plymouth"

prereqs()
{
    echo "${PREREQ}"
}

case "${1}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

OSIRIS_WATERMARK="/usr/share/plymouth/themes/osiris/watermark.png"
DESTDIR_WATERMARK="${DESTDIR}/usr/share/plymouth/themes/osiris/watermark.png"

if [ -f "${OSIRIS_WATERMARK}" ] && [ -d "${DESTDIR}/usr/share/plymouth/themes/osiris" ]; then
    cp "${OSIRIS_WATERMARK}" "${DESTDIR_WATERMARK}"
fi
