# Osiris Plymouth Boot Splash

# Set dark background
Window.SetBackgroundTopColor(0.10, 0.10, 0.10);
Window.SetBackgroundBottomColor(0.10, 0.10, 0.10);

# Load and display logo with error checking
if (Image("logo.png")) {
    logo_image = Image("logo.png");
    if (logo_image.GetWidth() > 0) {
        logo_sprite = Sprite(logo_image);
        logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
        logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2);
        logo_sprite.SetZ(1000);
        logo_sprite.SetOpacity(1);
    }
}

# Progress bar with error checking
if (Image("progress_bar.png")) {
    progress_image = Image("progress_bar.png");
    if (progress_image.GetWidth() > 0) {
        progress_sprite = Sprite();
        progress_sprite.SetPosition(Window.GetWidth() / 2 - 200, Window.GetHeight() - 80, 100);

        fun progress_callback(duration, progress) {
            if (progress >= 0 && progress <= 1) {
                scaled = progress_image.Scale(Math.Int(progress * 400), 6);
                if (scaled) progress_sprite.SetImage(scaled);
            }
        }
        Plymouth.SetBootProgressFunction(progress_callback);
    }
}

# Message handler (required)
fun message_callback(text) {
}
Plymouth.SetMessageFunction(message_callback);

# Refresh handler (required)
fun refresh_callback() {
}
Plymouth.SetRefreshFunction(refresh_callback);
