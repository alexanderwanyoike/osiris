#!/bin/bash
# Configure display manager for installed systems

set -e

echo "=== Configuring ly display manager ==="

# Enable ly (will start on installed systems)
systemctl enable ly.service

# Configure ly for Sway
mkdir -p /etc/ly
cat > /etc/ly/config.ini <<'EOF'
# Osiris ly configuration
animate = true
blank_password = false
clear_password = true

# Wayland session
waylandsessions = /usr/share/wayland-sessions

# Default to Sway
# (users can still choose other sessions if installed)
EOF

echo "✓ ly display manager configured"
echo "  Note: Auto-login (getty) is for live boot only"
echo "  Installed systems will use ly login manager"